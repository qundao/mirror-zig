<body>
  <header><h1>Zig Build System</h1></header>
  <div id="navigation">
    <nav>
      <h2 id="related-documentation">Related Documentation</h2>
      <table>
      <tr>
        <th>Resource</th>
        <th>Command Line</th>
      </tr>
      <tr>
        <td><a href="/documentation/master/">Language Reference</a></td>
        <td><code>zig doc langref</code></td>
      </tr>
      <tr>
        <td><a href="/documentation/master/std/">Standard Module Documentation</a></td>
        <td><code>zig doc std</code></td>
      </tr>
      <tr>
        <td>Build System (this document)</td>
        <td><code>zig doc build</code></td>
      </tr>
      </table>
    </nav>
    <nav>
      <h2 id="zig-version">Zig Version</h2>
      master (this document)
    </nav>
